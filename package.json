{
  "name": "@webship.co/workspace-angular",
  "version": "1.0.0",
  "description": "Angular for Webship Workspace: the builder (`cmd-angular-project.sh`) in every sites folder, which makes an Angular app with the Angular CLI (the official starter with server rendering, with the Angular step pack's demo pages by default) or takes one from its repository, builds it and serves it from a container of its own (Node.js in the app's container; DDEV by default, or Docker Compose, Podman or Kubernetes with --runtime): an app with server rendering by its own server, one without it by a static server that falls back to its single page. The Angular step pack wired into the testing setup of such an app, and its AI items in their folders: two agents, a skill, a command and two prompts for building and testing Angular apps.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-angular.git"
  },
  "files": [
    "dist/src",
    "ai",
    "commands",
    "features",
    "scripts",
    "testing",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "angular",
    "label": "Angular",
    "needs": [
      [
        "dev",
        "test",
        "sandboxes",
        "demos"
      ],
      "ai-agents",
      "ai-skills",
      "ai-commands",
      "ai-prompts"
    ],
    "commands": {
      "types": [
        "sites"
      ],
      "workspaces": [
        "dev",
        "test",
        "sandboxes",
        "demos"
      ],
      "files": [
        "commands/cmd-angular-project.sh"
      ]
    },
    "scripts": {
      "functions": [
        "scripts/functions/fun-angular.sh"
      ],
      "args": [
        "scripts/args/arg-angular.sh"
      ],
      "machine": [
        "testing/site.feature"
      ]
    },
    "ai": {
      "agents": [
        "ai/agents/angular-app-builder.md",
        "ai/agents/angular-tester.md"
      ],
      "skills": [
        "ai/skills/angular-scenarios"
      ],
      "commands": [
        "ai/commands/angular-test.md"
      ],
      "prompts": [
        "ai/prompts/angular-build-and-test.md",
        "ai/prompts/angular-scenarios-for-an-app.md"
      ]
    },
    "features": [
      "features/angular.feature",
      "features/angular-runtimes.feature"
    ],
    "featuresSite": "cmd-angular-project.sh ci-angular --install --runtime docker"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.13",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
